<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Writes the two JSON schemas that ship in the package (appsettings-schema.Umbraco.Community.PropertyVisibility.json and
		PropertyVisibility.config-schema.json) from the options model, with the XML docs as descriptions.
		Run it without arguments for its usage.
	-->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Umbraco.Community.PropertyVisibility.SchemaGenerator</RootNamespace>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="NJsonSchema" />
	</ItemGroup>

	<ItemGroup>
		<!-- The package's XML documentation file (GenerateDocumentationFile) is copied next to it and becomes the schema descriptions -->
		<ProjectReference Include="..\..\src\Umbraco.Community.PropertyVisibility\Umbraco.Community.PropertyVisibility.csproj" />
	</ItemGroup>

</Project>
