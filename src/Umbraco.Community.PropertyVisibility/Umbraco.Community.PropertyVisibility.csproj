<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Umbraco.Community.PropertyVisibility</RootNamespace>
		<!-- Serve wwwroot/App_Plugins/... at /App_Plugins/... from the consuming site -->
		<StaticWebAssetBasePath>/</StaticWebAssetBasePath>
		<!-- Ship XML docs for IntelliSense; CS1591 keeps public members documented under TreatWarningsAsErrors -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup Label="Package">
		<PackageId>Umbraco.Community.PropertyVisibility</PackageId>
		<Product>Umbraco.Community.PropertyVisibility</Product>
		<Title>Property Visibility</Title>
		<Description>Hide properties, groups and tabs per site in the Umbraco backoffice</Description>
		<Authors>Erwin Damsma</Authors>
		<Copyright>Copyright (c) 2026 Erwin Damsma</Copyright>
		<PackageTags>umbraco umbraco-marketplace backoffice multisite property-visibility</PackageTags>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README_nuget.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/erwindamsma/Umbraco.Community.PropertyVisibility</PackageProjectUrl>
		<RepositoryUrl>https://github.com/erwindamsma/Umbraco.Community.PropertyVisibility</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<!-- The PDB (with its SourceLink map) travels inside the dll, so consumers can step into the package source -->
		<DebugType>embedded</DebugType>
		<!--
			buildTransitive/Umbraco.Community.PropertyVisibility.props is this project's own file: it imports the static web
			assets chain the SDK still generates (buildMultiTargeting and build) and adds the JSON schemas. Without this switch
			the SDK would pack its generated file to the same path.
		-->
		<StaticWebAssetsDisableProjectBuildTransitivePropsFileGeneration>true</StaticWebAssetsDisableProjectBuildTransitivePropsFileGeneration>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Umbraco.Cms.Web.Common" />
		<PackageReference Include="Umbraco.Cms.Api.Common" />
		<PackageReference Include="Umbraco.Cms.Api.Management" />
	</ItemGroup>

	<ItemGroup>
		<!-- The unit tests bind real configuration through the package's own options registration -->
		<InternalsVisibleTo Include="Umbraco.Community.PropertyVisibility.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- The Client folder is a build input, never package content -->
		<Content Remove="Client\**" />
		<!-- Keep the manifest visible in the solution; it ships through the built wwwroot output, not as a pack item -->
		<None Include="Client\public\umbraco-package.json" Pack="false" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\docs\icon.png" Pack="true" PackagePath="\" />
		<None Include="..\..\docs\README_nuget.md" Pack="true" PackagePath="\" />
		<!--
			The licence text (the nuspec carries the MIT expression) and the third-party notices: the client bundle contains
			MIT-licensed Hey API client code, whose notice has to travel with every copy. tools/inspect-nupkg.sh requires both.
		-->
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
		<None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!--
		JSON schemas, generated by tools/Umbraco.Community.PropertyVisibility.SchemaGenerator from the options model and
		committed (CI fails on drift). They go to the nupkg root, where buildTransitive/*.JsonSchemas.props points
		Umbraco.Cms.Targets at them. The SDK globs *.json as Content (copied to the output, packed as contentFiles), so they
		are moved to None.
	-->
	<ItemGroup Label="JSON schemas">
		<_PvJsonSchema Include="appsettings-schema.Umbraco.Community.PropertyVisibility.json;PropertyVisibility.config-schema.json" />
		<Content Remove="@(_PvJsonSchema)" />
		<None Remove="@(_PvJsonSchema)" />
		<None Include="@(_PvJsonSchema)" Pack="true" PackagePath="\" />
		<None Remove="buildTransitive\**" />
		<None Include="buildTransitive\*.props" Pack="true" PackagePath="buildTransitive\" />
	</ItemGroup>

	<!--
		BuildClient: builds the backoffice client (Client/) into wwwroot/App_Plugins/UmbracoCommunityPropertyVisibility
		before static web assets are collected, so a plain dotnet build / dotnet pack is self-contained.
		PACKAGE_VERSION carries $(Version) into umbraco-package.json. Skip with -p:SkipClientBuild=true
		when the output is already built (CI pack step).
	-->
	<PropertyGroup>
		<_PvClientBuildEnabled Condition="'$(SkipClientBuild)' != 'true' AND Exists('$(MSBuildProjectDirectory)\Client\package.json')">true</_PvClientBuildEnabled>
		<_PvClientOutputDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'wwwroot', 'App_Plugins', 'UmbracoCommunityPropertyVisibility'))</_PvClientOutputDir>
		<_PvClientEntry>$(_PvClientOutputDir)property-visibility.js</_PvClientEntry>
		<_PvClientManifest>$(_PvClientOutputDir)umbraco-package.json</_PvClientManifest>
	</PropertyGroup>

	<ItemGroup>
		<ClientInput Include="Client\**" Exclude="Client\node_modules\**;Client\dist\**" />
	</ItemGroup>

	<!--
		The incremental check of BuildClient compares timestamps only, so it would keep output that no longer matches
		this build: a manifest carrying another version (a plain `npm run build` writes 0.0.0, an earlier build another
		$(Version)), which would break the ?umb__rnd cache busting, or source maps from a development build
		(`npm run watch`), which must never ship. Either condition deletes the entry file, so BuildClient runs.
	-->
	<Target Name="_PvCheckClientOutput" Condition="'$(_PvClientBuildEnabled)' == 'true' AND Exists('$(_PvClientEntry)')">
		<PropertyGroup>
			<_PvBuiltManifest Condition="Exists('$(_PvClientManifest)')">$([System.IO.File]::ReadAllText('$(_PvClientManifest)'))</_PvBuiltManifest>
			<_PvExpectedVersion>&quot;version&quot;: &quot;$(Version)&quot;</_PvExpectedVersion>
			<_PvClientStaleReason Condition="!$(_PvBuiltManifest.Contains('$(_PvExpectedVersion)'))">umbraco-package.json does not carry version $(Version)</_PvClientStaleReason>
		</PropertyGroup>
		<ItemGroup>
			<_PvClientSourceMap Include="$(_PvClientOutputDir)**\*.map" />
		</ItemGroup>
		<PropertyGroup>
			<_PvClientStaleReason Condition="'$(_PvClientStaleReason)' == '' AND '@(_PvClientSourceMap)' != ''">source maps from a development build are present</_PvClientStaleReason>
		</PropertyGroup>
		<Message Importance="high" Condition="'$(_PvClientStaleReason)' != ''" Text="BuildClient: rebuilding the client output, $(_PvClientStaleReason)." />
		<Delete Files="$(_PvClientEntry)" Condition="'$(_PvClientStaleReason)' != ''" />
	</Target>

	<Target Name="BuildClient"
	        BeforeTargets="AssignTargetPaths"
	        DependsOnTargets="_PvCheckClientOutput"
	        Condition="'$(_PvClientBuildEnabled)' == 'true'"
	        Inputs="@(ClientInput)"
	        Outputs="$(_PvClientEntry)">
		<Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)\Client" EnvironmentVariables="PACKAGE_VERSION=$(Version)" />
		<Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\Client" EnvironmentVariables="PACKAGE_VERSION=$(Version)" />
		<!--
			Re-point the Content items at what vite just wrote. The SDK evaluated its wwwroot/** glob before this target ran:
			on a first build the output did not exist yet, and after a client change vite's emptyOutDir deleted chunks whose
			hashed names changed, so the evaluated items would name files that no longer exist (static web assets then fail
			with "No file exists for the asset"). Metadata as in the SDK's own wwwroot glob.
		-->
		<ItemGroup>
			<_PvClientContent Include="@(Content)" Condition="$([MSBuild]::ValueOrDefault('%(Content.FullPath)', '').StartsWith('$(_PvClientOutputDir)'))" />
			<Content Remove="@(_PvClientContent)" />
			<Content Include="wwwroot\App_Plugins\UmbracoCommunityPropertyVisibility\**" ExcludeFromSingleFile="true" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

	<!--
		Pack: no content files. The SDK globs files such as *.json in the project folder as Content, and NuGet packs every
		Content item without a PackagePath into content/ and contentFiles/, so a stray appsettings.Production.json would
		ship. IncludeContentInPack=false does not fit: it switches off NuGet's _GetPackageFiles as a whole, which also packs
		the None items above and the static web assets (IncludeStaticWebAssetsPackItems adds those as Content with a
		PackagePath under staticwebassets/ and build/), leaving only the dll. So the Content items without a PackagePath are
		dropped just before NuGet collects the package files, after the build.
	-->
	<Target Name="_PvExcludeContentFilesFromPack" BeforeTargets="_GetPackageFiles">
		<ItemGroup>
			<_PvContentFileNotPacked Include="@(Content)" Condition="'%(Content.PackagePath)' == ''" />
			<Content Remove="@(_PvContentFileNotPacked)" />
		</ItemGroup>
		<Message Importance="high" Condition="'@(_PvContentFileNotPacked)' != ''" Text="Pack: not packed as content files: @(_PvContentFileNotPacked, ', ')" />
	</Target>

	<!--
		Pack: the backoffice client must be in the package. Without it the nupkg would still carry
		buildTransitive/$(PackageId).props, whose import of the static web assets chain then breaks every consuming build
		(MSB4019). build/ci/pack.sh inspects the package afterwards; this also stops a manual dotnet pack: the entry file and
		the manifest must be built, the manifest must carry $(Version), and both must be among the static web assets NuGet is
		about to pack.
	-->
	<Target Name="_PvVerifyPackedClient" BeforeTargets="GenerateNuspec">
		<PropertyGroup>
			<_PvPackedManifestText Condition="Exists('$(_PvClientManifest)')">$([System.IO.File]::ReadAllText('$(_PvClientManifest)'))</_PvPackedManifestText>
			<_PvPackedManifestVersion>&quot;version&quot;: &quot;$(Version)&quot;</_PvPackedManifestVersion>
			<_PvPackedAssetsPath>staticwebassets/App_Plugins/UmbracoCommunityPropertyVisibility/</_PvPackedAssetsPath>
		</PropertyGroup>
		<ItemGroup>
			<_PvPackedFile Include="@(Content)" PvPackagePath="$([MSBuild]::ValueOrDefault('%(Content.PackagePath)', '').Replace('\', '/'))" />
			<_PvPackedClientEntry Include="@(_PvPackedFile)" Condition="'%(_PvPackedFile.PvPackagePath)' == '$(_PvPackedAssetsPath)property-visibility.js'" />
			<_PvPackedClientManifest Include="@(_PvPackedFile)" Condition="'%(_PvPackedFile.PvPackagePath)' == '$(_PvPackedAssetsPath)umbraco-package.json'" />
		</ItemGroup>
		<Error Condition="!Exists('$(_PvClientEntry)') OR !Exists('$(_PvClientManifest)')"
		       Text="Pack: the backoffice client output is missing ($(_PvClientEntry) or $(_PvClientManifest)). Build without -p:SkipClientBuild=true, or pack with build/ci/build.sh and build/ci/pack.sh." />
		<Error Condition="!$(_PvPackedManifestText.Contains('$(_PvPackedManifestVersion)'))"
		       Text="Pack: $(_PvClientManifest) does not carry version $(Version); build the client with the version being packed (PACKAGE_VERSION=$(Version) bash build/ci/build.sh), then pack." />
		<Error Condition="'@(_PvPackedClientEntry)' == '' OR '@(_PvPackedClientManifest)' == ''"
		       Text="Pack: property-visibility.js and umbraco-package.json are not among the static web assets to pack (the last build ran without the client output). Build again, then pack." />
	</Target>

</Project>
