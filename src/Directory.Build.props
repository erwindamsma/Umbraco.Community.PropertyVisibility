<Project>

	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!--
		Umbraco.Cms 17 (up to 17.7.1) pins SixLabors.ImageSharp 3.1.12, and these advisories are only fixed in 4.1.2, which
		Umbraco 17 does not support. Only the test site and the unit tests reference it, so the advisories are accepted for
		the projects that do not ship and nowhere else; with TreatWarningsAsErrors they would fail the restore. Remove them once Umbraco ships a patched ImageSharp. The condition works here because MSBuild evaluates
		every property, including the project's IsPackable, before any item.
	-->
	<ItemGroup Condition="'$(IsPackable)' == 'false'">
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
	</ItemGroup>

</Project>
