<Project>

	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!--
		The Umbraco major of this build. One source builds two packages: 1.x for Umbraco 17 and 2.x for Umbraco 18. The first
		of these wins: -p:UmbracoMajor=18; the major of an exact -p:UmbracoCmsVersion=[18.2.1]; the major of a release
		-p:Version (1.x builds for 17, 2.x for 18); otherwise 17. src/Directory.Packages.props picks the Umbraco range and the
		uSync version from it, and the compile constant UMBRACO_17 or UMBRACO_18 selects the version-specific code.
	-->
	<PropertyGroup Label="Umbraco major">
		<UmbracoMajor Condition="'$(UmbracoMajor)' == '' AND '$(UmbracoCmsVersion)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(UmbracoCmsVersion)', '[0-9]+'))</UmbracoMajor>
		<UmbracoMajor Condition="'$(UmbracoMajor)' == '' AND $([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '^1\.'))">17</UmbracoMajor>
		<UmbracoMajor Condition="'$(UmbracoMajor)' == '' AND $([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '^2\.'))">18</UmbracoMajor>
		<UmbracoMajor Condition="'$(UmbracoMajor)' == ''">17</UmbracoMajor>
		<PvPackageMajor Condition="'$(UmbracoMajor)' == '17'">1</PvPackageMajor>
		<PvPackageMajor Condition="'$(UmbracoMajor)' == '18'">2</PvPackageMajor>
		<DefineConstants>$(DefineConstants);UMBRACO_$(UmbracoMajor)</DefineConstants>
	</PropertyGroup>

	<Target Name="_PvCheckUmbracoMajor" BeforeTargets="CollectPackageReferences;BeforeBuild">
		<PropertyGroup>
			<_PvUmbracoCmsMajor>$([System.Text.RegularExpressions.Regex]::Match('$(UmbracoCmsVersion)', '[0-9]+'))</_PvUmbracoCmsMajor>
		</PropertyGroup>
		<Error Condition="'$(PvPackageMajor)' == ''" Text="Umbraco $(UmbracoMajor) is not supported: build for Umbraco 17 (package 1.x) or 18 (package 2.x), for example -p:UmbracoMajor=18." />
		<Error Condition="'$(_PvUmbracoCmsMajor)' != '$(UmbracoMajor)'" Text="UmbracoCmsVersion $(UmbracoCmsVersion) is not an Umbraco $(UmbracoMajor) version (UmbracoMajor)." />
	</Target>

	<!--
		Umbraco.Cms 17 (up to 17.7.2) and 18 (up to 18.2.2) pin SixLabors.ImageSharp 3.1.12. GHSA-v76p-62qx-wwq2 is fixed in
		3.2.0, which 17.8 and 18.3 reference; the others only in 4.1.2, which neither supports. Only the test site and the unit tests reference it, so the advisories are accepted for
		the projects that do not ship and nowhere else; with TreatWarningsAsErrors they would fail the restore. Remove each once Umbraco ships an ImageSharp that fixes it. The condition works here because MSBuild evaluates
		every property, including the project's IsPackable, before any item.
	-->
	<ItemGroup Condition="'$(IsPackable)' == 'false'">
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
	</ItemGroup>

	<!--
		System.Security.Cryptography.Pkcs and System.Security.Cryptography.Xml up to 10.0.12 (advisories of 2026-10-13, fixed
		in 10.0.13). Umbraco.Cms 17 (up to 17.7.2) and 18 (up to 18.2.2) resolve both to 10.0.10, through
		Microsoft.AspNetCore.DataProtection (Examine, OpenIddict), and the test site resolves Pkcs 10.0.0. Every project gets
		them from Umbraco, the package itself included, which does not use them; a site gets the same audit warnings from its
		own Umbraco reference. With TreatWarningsAsErrors they would fail the restore. Remove them once Umbraco references
		10.0.13 or later.
	-->
	<ItemGroup>
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2fmv-rv2c-59x7" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-846f-f764-76mx" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-7hqp-7c5m-4vq6" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-c399-9853-6jmj" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-r955-8q5j-3h83" />
	</ItemGroup>

	<!--
		MessagePack before 3.1.9 (advisory of 2026-10-15). Umbraco.Cms 17 (up to 17.7.2) and 18 (up to 18.2.2) resolve it to
		3.1.8 for their own cache serialization; the same reasoning and removal condition as above, once Umbraco references
		3.1.9 or later.
	-->
	<ItemGroup>
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qhrr-8q5h-9q3h" />
	</ItemGroup>

</Project>
