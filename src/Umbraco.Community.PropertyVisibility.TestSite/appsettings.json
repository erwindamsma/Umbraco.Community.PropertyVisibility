{
	"$schema": "appsettings-schema.json",
	"Serilog": {
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft": "Warning",
				"Microsoft.Hosting.Lifetime": "Information",
				"System": "Warning"
			}
		}
	},
	"Umbraco": {
		"CMS": {
			"Global": {
				"Id": "2c57efe8-64fb-4dac-829b-785110fca4f8",
				"SanitizeTinyMce": true
			},
			"Content": {
				"AllowEditInvariantFromNonDefault": true,
				"ContentVersionCleanupPolicy": {
					"EnableCleanup": true
				}
			},
			"Unattended": {
				"UpgradeUnattended": true
			},
			"ModelsBuilder": {
				"ModelsMode": "Nothing"
			},
			"Security": {
				"AllowConcurrentLogins": false
			}
		}
	},
	"PropertyVisibility": {
		"Enabled": true,
		"ConfigFile": "PropertyVisibility.config.json",
		"HideEmptiedContainers": true,
		"ContentTypes": {
			"siteSettings": { "Containers": ["legacyTab"] }
		},
		"Sites": {
			"corporate": {
				"RootNodeKey": "5c2b4d7e-9f1a-4c3e-8b6d-2a1f0e9d8c7b",
				"RootNodeName": "Corporate site",
				"ContentTypes": {
					"landingPage": { "Properties": ["bannerImage", "relatedLinks"], "Containers": ["seoTab", "settingsTab/advanced"] },
					"article": { "Containers": ["shareTab"] },
					"variantPage": { "Properties": ["variantTagline"], "Containers": ["seoTab"] },
					"promoBanner": { "Properties": ["overlayColour"] },
					"promoBannerSettings": { "Properties": ["anchorId"] }
				}
			},
			"campaign": {
				"RootNodeName": "Campaign site",
				"ContentTypes": {
					"landingPage": { "Properties": ["metaKeywords"] },
					"callToAction": { "Containers": ["settingsTab"] }
				}
			},
			"everythingElse": {
				"IsDefault": true,
				"ContentTypes": {
					"landingPage": { "Properties": ["bannerImage"] }
				}
			}
		}
	}
}
