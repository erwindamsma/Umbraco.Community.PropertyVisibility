{
	"$schema": "appsettings-schema.json",
	"Serilog": {
		"MinimumLevel": {
			"Default": "Information"
		},
		"WriteTo": [
			{
				"Name": "Async",
				"Args": {
					"configure": [
						{
							"Name": "Console"
						}
					]
				}
			}
		]
	},
	"ConnectionStrings": {
		"umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Foreign Keys=True;Pooling=True",
		"umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
	},
	"Umbraco": {
		"CMS": {
			"Global": {
				"DatabaseServerRegistrar": {
					"WaitTimeBetweenCalls": "00:30:00",
					"StaleServerTimeout": "01:00:00"
				},
				"DatabaseServerMessenger": {
					"TimeBetweenSyncOperations": "00:05:00"
				}
			},
			"Unattended": {
				"InstallUnattended": true,
				"UnattendedUserName": "Administrator",
				"UnattendedUserEmail": "admin@example.com",
				"UnattendedUserPassword": "PropertyVisibilityDev1!"
			},
			"Hosting": {
				"Debug": true
			},
			"WebRouting": {
				"UmbracoApplicationUrl": "https://localhost:44300"
			},
			"Imaging": {
				"HMACSecretKey": "UHJvcGVydHlWaXNpYmlsaXR5IHRlc3Qgc2l0ZSBkdW1teSBITUFDIGtleSAtIG5vdCBhIHNlY3JldA=="
			},
			"DistributedJobs": {
				"Period": "01:00:00"
			}
		}
	},
	"uSync": {
		"Settings": {
			"ImportAtStartup": "None",
			"ImportOnFirstBoot": true,
			"FirstBootGroup": "All",
			"ExportOnSave": "None"
		}
	}
}
